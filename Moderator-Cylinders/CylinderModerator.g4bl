physics FTFP_BERT_PEN #minRangeCut=0.001
randomseed Set $T

#param M=0.511 KE=0.500
#param P=sqrt(($M+$KE)*($M+$KE)-$M*$M)
#beam gaussian meanMomentum=$P nEvents=100000 particle=e+

beam ascii filename="LBandOut_Edited_$T.txt" nEvents=100000 particle=e+ z=0

#tubs Moderator2 material=W innerRadius=0 outerRadius=0.010 length=10 maxStep=0.001
#place Moderator2 z=0.015 rotation=X90

box Moderator2 material=W height=10 width=0.020 length=0.020 maxStep=0.001
place Moderator2 z=0.015

#trace nTrace=10 format=ascii filename=Track%d.txt

zntuple z=0.001 filename=ModeratorOutC$T format=ascii
beamlossntuple DetKill filename=ModeratorOut$T format=ascii
newparticlentuple DetKill2 filename=ModeratorOutB$T format=ascii

# Parameters
param deltaChord=0.001
param deltaIntersection=0.0001
param deltaOneStep=0.0001
param minStep=0.00005
trackcuts kineticEnergyCut=0.00005
