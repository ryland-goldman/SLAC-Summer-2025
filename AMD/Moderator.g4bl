physics FTFP_BERT_PEN #minRangeCut=0.001
randomseed Set $T

#param M=0.511 KE=0.500
#param P=sqrt(($M+$KE)*($M+$KE)-$M*$M)
#beam gaussian meanMomentum=$P nEvents=100000 particle=e+

#beam ascii filename="TargetOutFiltered$T.txt" nEvents=100000 particle=e+ z=0

#beam ascii filename="LBandOut$T.txt" nEvents=100000 particle=e+ z=0
beam ascii filename="LBandOut_Edited_$T.txt" nEvents=100000 particle=e+ z=0

#box Moderator material=W width=100 height=100 length=0.050
tubs Moderator material=W innerRadius=0 outerRadius=100 length=0.001 maxStep=0.001
place Moderator z=1

# Kill detector
zntuple z=0.95 filename=ModeratorOutC$T format=ascii
beamlossntuple DetKill filename=ModeratorOut$T format=ascii
newparticlentuple DetKill2 filename=ModeratorOutB$T format=ascii


# Parameters
param deltaChord=0.001
param deltaIntersection=0.0001
param deltaOneStep=0.0001
param minStep=0.00005
trackcuts kineticEnergyCut=0.00005

#fieldexpr field Bz=0.5 Br=0 Ez=0.001 Er=0 width=1000 height=1000 length=1000
#place field z=0